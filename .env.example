# Debt Control - exemplo de variaveis de ambiente
# Configure em producao no painel da Vercel (nao versionar arquivo .env real).

# Obrigatorias em producao (Vercel + Supabase)
# Use a string do Supabase Transaction Pooler (porta 6543), sem sslmode na URL.
DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@<region>.pooler.supabase.com:6543/postgres
SESSION_SECRET=<gerar_um_segredo_forte_com_32_ou_mais_caracteres>
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase_service_role_key>
SUPABASE_STORAGE_BUCKET=<bucket_privado_de_comprovantes>

# Opcionais / recomendadas
NODE_ENV=development
PORT=5000
SUPABASE_ANON_KEY=<supabase_anon_key>

# Sessao/cookie (ajuste conforme dominio frontend/API)
SESSION_COOKIE_NAME=fincontrol.sid
# "lax" para mesmo dominio; "none" para cross-site com HTTPS.
SESSION_COOKIE_SAME_SITE=lax
# Desenvolvimento local:
# SESSION_COOKIE_SECURE=false
# Producao HTTPS (obrigatorio):
# SESSION_COOKIE_SECURE=true
# Exemplo: .seudominio.com (sem protocolo, porta ou path). Deixe vazio no local.
# SESSION_COOKIE_DOMAIN=.seudominio.com
# Somente desenvolvimento local.
# Em producao, deixe ausente ou use false.
# SESSION_STORE_CREATE_TABLE_IF_MISSING=true

# Storage de comprovantes (somente desenvolvimento local)
ALLOW_LOCAL_FILESYSTEM_STORAGE_FALLBACK=false
PAYMENT_PROOF_STORAGE_DIR=./uploads/comprovantes
PAYMENT_PROOF_MAX_BYTES=3145728

# Seed demo local (opcional)
ENABLE_DEMO_SEED=false
DEMO_SEED_USERNAME=dev_demo_local
DEMO_SEED_PASSWORD=<senha_forte_para_demo_local>
