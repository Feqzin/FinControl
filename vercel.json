{
  "version": 2,
  "buildCommand": "npm run check:serverless && npm run build:client",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
